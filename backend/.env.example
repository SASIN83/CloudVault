# Security
JWT_SECRET_KEY=this-key-is-for-testing
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite for dev — swap for PostgreSQL in production)
DATABASE_URL=sqlite:///./cloudvault.db


# AWS S3 (IAM user: cloudvault-app)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# CORS (comma-separated frontend origins)
ALLOWED_ORIGINS=http://localhost:5173
